<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <!-- Album Art / Track Icon -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_track_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        app:cardBackgroundColor="#151b26"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/image_track_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Track Artwork"
            android:scaleType="centerCrop"
            android:src="@drawable/default_album_art_144px" />
    </androidx.cardview.widget.CardView>

    <!-- Track Information (Title & Artist/Duration) -->
    <LinearLayout
        android:id="@+id/layout_track_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="12dp"
        android:layout_toStartOf="@id/btn_track_menu"
        android:layout_toEndOf="@id/card_track_art"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Track Title"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_track_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Artist • 0:00"
            android:textColor="#8b949e"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Context Menu Trigger Button (3-dots) -->
    <ImageButton
        android:id="@+id/btn_track_menu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Track Options"
        android:src="@drawable/more_vert_24px"
        app:tint="#8b949e" />

</RelativeLayout>